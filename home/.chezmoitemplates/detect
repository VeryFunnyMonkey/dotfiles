{{- /*
  Facts about this machine, as JSON: platform (arch|fedora|debian|darwin|unknown),
  wsl (a WSL kernel), display (wayland|x11|darwin|windows|none), desktop (kde|hyprland|gnome|macos|windows|"").
  display and desktop are detected once and then kept in chezmoi's config, so an
  apply from an SSH session doesn't decide the machine has no display.
*/ -}}
{{- $platform := includeTemplate "platform" . | trim -}}
{{- $wsl := false -}}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") -}}
{{-   if contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}{{- $wsl = true -}}{{- end -}}
{{- end -}}
{{- $display := dig "display" "" . -}}
{{- /* "wsl" is what older configs stored for Windows */ -}}
{{- if eq $display "wsl" -}}{{- $display = "windows" -}}{{- end -}}
{{- /* a machine stored as Windows is one, also where the kernel can't be read (scripts/check-packages.sh renders it) */ -}}
{{- if eq $display "windows" -}}{{- $wsl = true -}}{{- end -}}
{{- if not $display -}}
{{-   if eq .chezmoi.os "darwin" -}}{{- $display = "darwin" -}}
{{-   else if $wsl -}}{{- $display = "windows" -}}
{{-   else if or (env "WAYLAND_DISPLAY") (eq (env "XDG_SESSION_TYPE") "wayland") -}}{{- $display = "wayland" -}}
{{-   else if env "DISPLAY" -}}{{- $display = "x11" -}}
{{-   else -}}{{- $display = "none" -}}{{- end -}}
{{- end -}}
{{- $desktop := dig "desktop" "" . -}}
{{- if not $desktop -}}
{{-   $xdg := lower (env "XDG_CURRENT_DESKTOP") -}}
{{-   if eq .chezmoi.os "darwin" -}}{{- $desktop = "macos" -}}
{{-   else if $wsl -}}{{- $desktop = "windows" -}}
{{-   else if contains "kde" $xdg -}}{{- $desktop = "kde" -}}
{{-   else if contains "hyprland" $xdg -}}{{- $desktop = "hyprland" -}}
{{-   else if contains "gnome" $xdg -}}{{- $desktop = "gnome" -}}
{{-   end -}}
{{- end -}}
{{- /* A machine with the Hyprland item gets its display from it, even when set
       up from a console (where nothing was detected, or "none" was stored). */ -}}
{{- if and (has "hyprland" (dig "selected" list .)) (ne .chezmoi.os "darwin") (not $wsl) -}}
{{-   if eq $display "none" -}}{{- $display = "wayland" -}}{{- end -}}
{{-   if not $desktop -}}{{- $desktop = "hyprland" -}}{{- end -}}
{{- end -}}
{{- /* the platform an item is matched against: Windows (through WSL) counts separately */ -}}
{{- $target := $platform -}}{{- if $wsl -}}{{- $target = "windows" -}}{{- end -}}
{{- dict "platform" $platform "target" $target "wsl" $wsl "display" $display "desktop" $desktop | toJson -}}
