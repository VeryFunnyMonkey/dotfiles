{{- /* The OS settings for this machine's selected items, one per line:
       item TAB kind TAB id TAB value TAB extra
       How each kind's fields map to these: catalog/_setting-kinds.yaml
     Restarts: "item TAB restart TAB app" */ -}}
{{- $d := includeTemplate "detect" . | fromJson -}}
{{- $en := includeTemplate "enabled" . | fromJson -}}
{{- range $id := $en.selected -}}
{{-   $it := index $.catalog $id -}}
{{-   $req := dig "requires" list $it -}}
{{-   $ok := true -}}
{{-   range $r := $req -}}{{- if not (has $r $en.selected) -}}{{- $ok = false -}}{{- end -}}{{- end -}}
{{-   if $ok -}}
{{-     range $s := (dig "settings" list $it) -}}
{{-       $k := index $.setting_kinds $s.kind -}}
{{-       $w := dig "when" dict $k -}}
{{-       $on := true -}}
{{-       if and (hasKey $w "desktop") (ne $w.desktop $d.desktop) }}{{ $on = false }}{{ end -}}
{{-       if and (hasKey $w "platform") (ne $w.platform $d.platform) }}{{ $on = false }}{{ end -}}
{{-       if and (hasKey $w "not_platform") (eq $w.not_platform $d.platform) }}{{ $on = false }}{{ end -}}
{{-       if $on -}}
{{-         $val := index $s (dig "value" "value" $k) -}}
{{-         $extra := "" }}{{ if hasKey $k "extra" }}{{ $extra = index $s $k.extra }}{{ end -}}
{{-         if hasKey $k "each" -}}
{{-           range $one := index $s $k.each }}
{{ $id }}	{{ $s.kind }}	{{ $one }}	{{ $val }}{{ if $extra }}	{{ $extra }}{{ end }}
{{-           end -}}
{{-         else -}}
{{-           $parts := list -}}{{- range $f := $k.id -}}{{- $parts = append $parts (index $s $f) -}}{{- end }}
{{ $id }}	{{ $s.kind }}	{{ join "|" $parts }}	{{ $val }}{{ if $extra }}	{{ $extra }}{{ end }}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-     range $r := (dig "restart" list $it) }}
{{ $id }}	restart	{{ $r }}		
{{-     end -}}
{{-   end -}}
{{- end }}
