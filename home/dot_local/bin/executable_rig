#!/usr/bin/env bash
# rig: the machine side of these dotfiles (install, update, health, reset,
# uninstall). Workspaces are `dev`, server mounts `srv`. Run `rig help`.
#
# This file only sets up the environment, loads rig's parts and dispatches.
# The parts live in share/rig (next to this file, so rig also runs straight
# from the repo):
#   lib/       building blocks: output (base, also loaded by dev, srv, desk), prompts, machine state, the ledger,
#              systemd units, the catalog, applying a selection, the module registry
#   pkg/       packages: one set of functions per manager and per download; sync, drift
#   modules/   one feature each (shell, git, nvim, containers, ...), see lib/modules.sh
#   commands/  what you type: setup, add/remove, doctor, update, reset, uninstall
set -euo pipefail
# Homebrew asks before installing ("Do you want to proceed? [y/n]"); rig has
# already asked (setup's review), so every brew rig runs goes ahead.
export HOMEBREW_NO_ASK=1
USER=${USER:-$(id -un)}

# Homebrew may not be on PATH yet (fresh shell right after it was installed).
if ! command -v brew >/dev/null 2>&1; then
  for _b in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [[ -x $_b ]] && { eval "$("$_b" shellenv)"; break; }
  done
fi
PATH="$HOME/.local/bin:$PATH"

# shellcheck disable=SC2034  # die's prefix, read by lib/base.sh
TOOL=rig
RIG_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../share/rig" 2>/dev/null && pwd)" || RIG_LIB="${XDG_DATA_HOME:-$HOME/.local/share}/rig"
[[ -r $RIG_LIB/lib/base.sh ]] || { echo "rig: its libraries are missing ($RIG_LIB); run chezmoi apply" >&2; exit 1; }

# lib/ in dependency order, then everything else (each file only defines functions)
for _f in "$RIG_LIB"/lib/{base,sys,ui,machine,ledger,units,windows,catalog,apply,modules}.sh \
          "$RIG_LIB"/pkg/*.sh "$RIG_LIB"/modules/*.sh "$RIG_LIB"/modules/*/*.sh "$RIG_LIB"/commands/*.sh; do
  # shellcheck source=/dev/null
  [[ -r $_f ]] && source "$_f"
done
unset _f _b

main() {
  local cmd=${1:-help}; (($#)) && shift
  case $cmd in
    setup) cmd_setup "$@" ;;
    add|install) cmd_add "$@" ;;
    remove|rm|uninstall-pkg) cmd_del "$@" ;;
    profile|profiles) cmd_profile_cmd "$@" ;;
    info) cmd_info "$@" ;;
    sync) cmd_sync "$@" ;;
    search) cmd_search "$@" ;;
    drift) cmd_drift "$@" ;;
    update|up) cmd_update "$@" ;;
    doctor) cmd_doctor "$@" ;;
    edit) cmd_edit "$@" ;;
    export) cmd_export "$@" ;;
    import) cmd_import "$@" ;;
    diff) chezmoi diff "$@" ;;
    apply) chezmoi apply "$@" ;;
    reset) cmd_reset "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    modules|module) cmd_modules "$@" ;;
    homelab) tailscale_cmd "$@" ;;          # older name of the tailscale module
    agent) agents_cmd "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
      # a module's own command: rig git ..., rig agents ..., rig settings ...
      if module_exists "$cmd" && module_has "$cmd" cmd; then "$(module_fn "$cmd" cmd)" "$@"
      else die "unknown command '$cmd' (rig help)"; fi ;;
  esac
}
main "$@"
