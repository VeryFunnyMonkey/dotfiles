#!/usr/bin/env bash
# The settings and colours below are used by the parts in share/dev/.
# shellcheck disable=SC2034
# dev: tmux workspaces. A workspace is a `.dev` file (in the repo, or kept on
# this machine in ~/.config/dev/projects/); `dev` builds a tmux session from it
# and attaches. Without one you get the default: your agent + nvim.
# Run `dev help`.
set -euo pipefail

DEV_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/dev"
REGISTRY="$DEV_CFG/registry"
LOCAL_STORE="$DEV_CFG/projects"
TEMPLATES="$DEV_CFG/templates"
AGENT_FILE="$DEV_CFG/agent"
PATH="$HOME/.local/bin:$PATH"

if [[ -t 1 ]]; then B=$'\e[1m' DIM=$'\e[2m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m'; else B='' DIM='' G='' Y='' R='' N=''; fi
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%sdev:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
have tmux || die "tmux isn't installed"

# The parts live in share/dev (next to this file, so it also runs from the repo):
# projects, agent, build (sessions), workspace (init/edit), picker, worktrees, help.
DEV_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../share/dev" 2>/dev/null && pwd)" || DEV_LIB="${XDG_DATA_HOME:-$HOME/.local/share}/dev"
for _f in "$DEV_LIB"/*.sh; do
  # shellcheck source=/dev/null
  source "$_f"
done
unset _f

main() {
  local args=()
  while (($#)); do
    case $1 in
      --agent) DEV_AGENT_OVERRIDE=${2:-}; shift ;;
      --no-agent) DEV_NO_AGENT=1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- "${args[@]+"${args[@]}"}"
  local cmd=${1:-}
  case $cmd in
    ls|pick) cmd_ls ;;
    init) shift; cmd_init "$@" ;;
    edit) shift; cmd_edit "$@" ;;
    agent) shift; cmd_agent "$@" ;;
    wt) shift; cmd_wt "$@" ;;
    forget) shift; cmd_forget "$@" ;;
    _preview) shift; cmd_preview "$@" ;;
    _items) shift; picker_items "$@" ;;
    help|-h|--help) cmd_help ;;
    '')
      # In a project (a git repo, or a folder with a workspace): open it.
      # Anywhere else (e.g. ~): the picker.
      local root; root=$(project_root "$PWD")
      if [[ $root != "$HOME" ]] && { git -C "$PWD" rev-parse >/dev/null 2>&1 || workspace_file "$root" >/dev/null; }; then
        open_project "$root"
      else
        cmd_ls
      fi ;;
    *)
      [[ -d $cmd ]] || die "no such directory or command: $cmd (dev help)"
      open_project "$(project_root "$cmd")" ;;
  esac
}
main "$@"
