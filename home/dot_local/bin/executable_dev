#!/usr/bin/env bash
# dev: tmux workspaces. A workspace is a `.dev` file (in the repo, or kept on
# this machine in ~/.config/dev/projects/); `dev` builds a tmux session from it
# and attaches. Without one you get the default: your agent + nvim.
# Run `dev help`.
set -euo pipefail

DEV_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/dev"
REGISTRY="$DEV_CFG/registry"
LOCAL_STORE="$DEV_CFG/projects"
TEMPLATES="$DEV_CFG/templates"
AGENT_FILE="$DEV_CFG/agent"
PATH="$HOME/.local/bin:$PATH"

if [[ -t 1 ]]; then B=$'\e[1m' DIM=$'\e[2m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m'; else B='' DIM='' G='' Y='' R='' N=''; fi
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%sdev:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
have tmux || die "tmux isn't installed"


# ------------------------------------------------------------- projects -------
project_root() { # dir -> git toplevel (or the dir itself)
  local d; d=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  git -C "$d" rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "$d"
}
session_name() { local n; n=$(basename "$1"); printf '%s' "${n//[.:]/_}"; }
workspace_file() { # root -> the .dev file in use, if any
  if [[ -f $1/.dev ]]; then printf '%s\n' "$1/.dev"
  elif [[ -f $LOCAL_STORE/$(session_name "$1") ]]; then printf '%s\n' "$LOCAL_STORE/$(session_name "$1")"
  else return 1; fi
}
register() { mkdir -p "$DEV_CFG"; touch "$REGISTRY"; grep -qxF "$1" "$REGISTRY" || printf '%s\n' "$1" >>"$REGISTRY"; }
prune_registry() {
  [[ -f $REGISTRY ]] || return 0
  local tmp; tmp=$(mktemp)
  while IFS= read -r p; do [[ -d $p ]] && workspace_file "$p" >/dev/null && printf '%s\n' "$p"; done <"$REGISTRY" | sort -u >"$tmp"
  mv "$tmp" "$REGISTRY"
}

# ------------------------------------------------------------- agent ----------
agent_cmd() { # honours --agent / --no-agent (DEV_AGENT_OVERRIDE), $DEV_AGENT, the saved file
  if [[ ${DEV_NO_AGENT:-0} == 1 ]]; then return 0; fi
  if [[ -n ${DEV_AGENT_OVERRIDE:-} ]]; then printf '%s' "$DEV_AGENT_OVERRIDE"
  elif [[ -n ${DEV_AGENT:-} ]]; then printf '%s' "$DEV_AGENT"
  elif [[ -s $AGENT_FILE ]]; then head -n1 "$AGENT_FILE"
  else
    # the machine's default agent from setup (rig agents default <name>)
    local d; d=$(sed -n 's/^RIG_AGENT_DEFAULT="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "${XDG_CONFIG_HOME:-$HOME/.config}/rig/machine.env" 2>/dev/null)
    if [[ -n $d ]]; then printf '%s' "$d"; fi
  fi
}
cmd_agent() {
  case ${1:-} in
    set) shift; (($#)) || die "usage: dev agent set <command>"; mkdir -p "$DEV_CFG"; printf '%s\n' "$*" >"$AGENT_FILE"
         ok "dev starts '$*' in the left pane"; have "${1%% *}" || warn "'${1%% *}' isn't installed yet" ;;
    unset) rm -f "$AGENT_FILE"; ok "no agent: the left pane is a plain shell" ;;
    '') local c; c=$(agent_cmd); echo "${c:-(none: dev agent set <command>, or rig agents add <name>)}" ;;
    *) die "usage: dev agent [set <command> | unset]" ;;
  esac
}

# ------------------------------------------------------------- build ----------
# Type a command into a pane's shell, so you're back at a prompt when it ends.
pane_run() { # target command
  local target=$1 cmd=$2
  if [[ -z $cmd || $cmd == shell ]]; then return 0; fi
  if [[ $cmd == agent ]]; then
    cmd=$(agent_cmd)
    if [[ -z $cmd ]]; then return 0; fi
    if ! have "${cmd%% *}"; then
      tmux send-keys -t "$target" "printf 'dev: %s not found. Set one with: dev agent set <command>\\n' '${cmd%% *}'" Enter
      return 0
    fi
  fi
  tmux send-keys -t "$target" "$cmd" Enter
}

default_workspace() { printf '[code]\nagent\nnvim\n'; }

# Build session $1 in $2 from a workspace (on stdin).
build_session() {
  local name=$1 root=$2 win='' layout='' first=1 panes=0 line cmds=()
  flush_window() {
    [[ -n $win ]] || return 0
    local target="$name:$win" i
    ((${#cmds[@]})) || cmds=(shell)
    if ((first)); then tmux new-session -d -s "$name" -n "$win" -c "$root"; first=0
    else tmux new-window -d -t "$name:" -n "$win" -c "$root"; fi
    for ((i = 1; i < ${#cmds[@]}; i++)); do tmux split-window -d -t "$target" -c "$root"; done
    # agent on the left (40%), the rest on the right
    tmux set-window-option -t "$target" main-pane-width '40%' >/dev/null 2>&1 || true
    tmux select-layout -t "$target" "${layout:-main-vertical}" >/dev/null
    local idx=0 pane
    while IFS= read -r pane; do
      pane_run "$pane" "${cmds[$idx]:-shell}"; ((idx++)) || true
    done < <(tmux list-panes -t "$target" -F '#{pane_id}')
    tmux select-pane -t "$target.{last}" 2>/dev/null || true
    cmds=(); panes=$((panes + 1))
  }
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    if [[ $line =~ ^[[:space:]]*# || -z ${line//[[:space:]]/} ]]; then continue; fi
    if [[ $line =~ ^\[([^]]+)\][[:space:]]*([a-z-]*) ]]; then
      flush_window
      win=${BASH_REMATCH[1]}; layout=${BASH_REMATCH[2]}
    else
      [[ -n $win ]] || { win=code; layout=''; }
      cmds+=("${line#"${line%%[![:space:]]*}"}")
    fi
  done
  flush_window
  ((first == 0)) || tmux new-session -d -s "$name" -c "$root"
  tmux select-window -t "$name:^" 2>/dev/null || true
}

attach() {
  if [[ ${DEV_NO_ATTACH:-0} == 1 ]]; then return 0; fi  # tests / scripts
  if [[ -n ${TMUX:-} ]]; then tmux switch-client -t "$1"; else tmux attach-session -t "$1"; fi
}

open_project() { # root
  local root=$1 name ws
  name=$(session_name "$root")
  if tmux has-session -t "=$name" 2>/dev/null; then attach "$name"; return; fi
  if ws=$(workspace_file "$root"); then
    register "$root"
    build_session "$name" "$root" <"$ws"
  else
    default_workspace | build_session "$name" "$root"
  fi
  attach "$name"
}

# ------------------------------------------------------------- init/edit ------
cmd_init() {
  local tmpl=default where='' root
  while (($#)); do
    case $1 in
      --local) where=local ;;
      --repo) where=repo ;;
      -*) die "unknown option $1" ;;
      *) tmpl=$1 ;;
    esac
    shift
  done
  root=$(project_root "$PWD")
  [[ -f $TEMPLATES/$tmpl ]] || die "no template '$tmpl' (have: $(ls "$TEMPLATES" 2>/dev/null | tr '\n' ' '))"
  [[ -n $where ]] || where=repo
  local file
  if [[ $where == local ]]; then mkdir -p "$LOCAL_STORE"; file="$LOCAL_STORE/$(session_name "$root")"
  else file="$root/.dev"; fi
  if [[ -e $file ]]; then die "a workspace already exists: $file (dev edit)"; fi
  cp "$TEMPLATES/$tmpl" "$file"
  register "$root"
  ok "workspace ${file/#$HOME/~} (from template $tmpl)"
  if [[ $where == local ]]; then printf '  %skept on this machine, not in the repo%s\n' "$DIM" "$N"; fi
  "${EDITOR:-nvim}" "$file"
}
cmd_edit() {
  local root ws; root=$(project_root "${1:-$PWD}")
  ws=$(workspace_file "$root") || die "no workspace here (dev init)"
  "${EDITOR:-nvim}" "$ws"
}
cmd_forget() {
  local root; root=$(project_root "${1:-$PWD}") || root=${1:-$PWD}
  [[ -f $REGISTRY ]] && { grep -vxF "$root" "$REGISTRY" >"$REGISTRY.new" || true; mv "$REGISTRY.new" "$REGISTRY"; }
  ok "forgot $root"
}

# ------------------------------------------------------------- picker ---------
# One line per project: what fzf shows, then (hidden) kind, session name, path.
#   kind: run = a tmux session is running, ws = has a workspace file, dir = a repo
# Projects are git repos: the ones zoxide knows (folders you've been in) and
# the ones under ~/Projects, plus anything with a running session or workspace.
# a repo inside another repo (a vendored library, a reference copy) isn't a project
nested_repo() { local d=${1%/*}; while [[ $d == "$HOME"/* ]]; do [[ -e $d/.git ]] && return 0; d=${d%/*}; done; return 1; }
picker_entries() { # kind \t name \t path \t tabs
  prune_registry
  local s p w n seen=$'\n'
  # open sessions, not the throwaway ones each Ghostty window opens
  # (\x1f between fields: with tabs, read would merge the empty @rig_window field away)
  while IFS=$'\x1f' read -r s p w n; do
    if [[ $w == 1 ]]; then continue; fi
    printf 'run\t%s\t%s\t%s\n' "$s" "$p" "$n"; seen+="$p"$'\n'
  done < <(tmux list-sessions -F $'#{session_name}\x1f#{session_path}\x1f#{@rig_window}\x1f#{session_windows}' 2>/dev/null || true)
  if [[ -f $REGISTRY ]]; then
    while IFS= read -r p; do
      if [[ $seen == *$'\n'"$p"$'\n'* ]]; then continue; fi
      printf 'ws\t%s\t%s\t\n' "$(session_name "$p")" "$p"; seen+="$p"$'\n'
    done <"$REGISTRY"
  fi
  # other git repos: most used first (zoxide), then the rest of ~/Projects
  {
    if have zoxide; then zoxide query -l 2>/dev/null | head -n 200; fi
    find "$HOME/Projects" -mindepth 2 -maxdepth 4 -name .git -prune 2>/dev/null | sed 's#/\.git$##' | sort
  } | while IFS= read -r p; do
    [[ -e $p/.git && $seen != *$'\n'"$p"$'\n'* ]] || continue
    if nested_repo "$p"; then continue; fi
    case $p in *.wt/*) continue ;; esac   # dev wt worktrees show under their repo
    printf 'dir\t%s\t%s\t\n' "$(session_name "$p")" "$p"; seen+="$p"$'\n'
  done
}
# Rows: name (as wide as the longest), status, the folder it's in (dim).
# --all adds every other folder under your home, for searching.
picker_items() {
  local entries kind name path tabs label width=8 scol=0
  entries=$(picker_entries)
  while IFS=$'\t' read -r kind name path tabs; do
    [[ -n $kind ]] || continue
    if [[ $kind != dir ]]; then scol=15; fi   # a status column only if something has one
    label=${path##*/}; [[ $kind == run ]] && label=$name
    if ((${#label} > width)); then width=${#label}; fi
  done <<<"$entries"
  if ((width > 22)); then width=22; fi
  while IFS=$'\t' read -r kind name path tabs; do
    [[ -n $kind ]] || continue
    label=${path##*/}; [[ $kind == run ]] && label=$name
    if ((${#label} > width)); then label="${label:0:width-1}…"; fi
    local state='' text='' where=${path%/*}
    case $kind in
      run) text="open, $tabs tab$([[ $tabs == 1 ]] || echo s)"; state=$'\033[32m● '"$text"$'\033[0m' ;;
      ws)  text="workspace"; state=$'\033[34m★ '"$text"$'\033[0m' ;;
    esac
    # padded by hand: printf counts bytes, and the symbols are 3 bytes each
    local pad=$((scol - (${#text} ? ${#text} + 2 : 0)))
    if ((scol)); then pad=$((pad + 2)); fi
    printf '%-*s  %s%*s\033[2m%s\033[0m\t%s\t%s\t%s\n' "$width" "$label" "$state" "$pad" '' \
      "${where/#"$HOME"/\~}" "$kind" "$name" "$path"
  done <<<"$entries"
  if [[ ${1:-} != --all ]]; then return 0; fi
  # then every other folder under your home, so fuzzy search finds any path
  local projects; projects=$(cut -f3 <<<"$entries")
  all_dirs | awk -v home="$HOME" -v seen="$projects" '
    BEGIN { n = split(seen, a, "\n"); for (i = 1; i <= n; i++) skip[a[i]] = 1 }
    { p = home "/" $0; sub(/\/$/, "", p); if (p in skip) next
      n = p; sub(/.*\//, "", n); gsub(/[.:]/, "_", n)
      printf "\033[2m~/%s\033[0m\tfolder\t%s\t%s\n", substr(p, length(home) + 2), n, p; fflush() }'
}
# Folders under your home, shallow ones first (fd in depth bands, so the list
# still streams). fd's defaults skip what .gitignore ignores (node_modules,
# build output); caches and the trash are left out too.
all_dirs() {
  local fd; if have fd; then fd=fd; elif have fdfind; then fd=fdfind; else fd=''; fi
  if [[ -z $fd ]]; then
    (cd "$HOME" && find . -mindepth 1 -maxdepth 6 -type d -not -path '*/.git*' -not -path './.cache*' -printf '%P\n' 2>/dev/null) || true
    return 0
  fi
  # also left out: dependency and tool folders nobody opens a workspace in
  local x=(--type d --hidden --base-directory "$HOME"
           --exclude .git --exclude .cache --exclude Trash --exclude node_modules --exclude __pycache__
           --exclude .venv --exclude venv --exclude site-packages --exclude .npm --exclude .cargo
           --exclude .rustup --exclude .local/lib --exclude .local/share/nvim --exclude .local/share/fnm
           --exclude go/pkg --exclude .wine --exclude .steam --exclude .local/share/Steam .)
  "$fd" --max-depth 2 "${x[@]}" 2>/dev/null || true
  "$fd" --min-depth 3 --max-depth 3 "${x[@]}" 2>/dev/null || true
  "$fd" --min-depth 4 --max-depth 4 "${x[@]}" 2>/dev/null || true
  "$fd" --min-depth 5 "${x[@]}" 2>/dev/null || true
}
cmd_preview() { # kind name path
  local kind=$1 name=$2 path=$3 ws
  printf '\033[1m%s\033[0m  %s\n\n' "${path##*/}" "${path/#"$HOME"/\~}"
  if [[ $kind == folder ]]; then
    printf 'A folder. Enter opens it in tmux:\n  left:  %s\n  right: nvim\n\n' "$(left_pane)"
    ls -A --color=always "$path" 2>/dev/null | head -n 40
    return 0
  elif [[ $kind == run ]]; then
    printf 'Open now. Enter switches to it. Its tabs:\n\n'
    tmux list-windows -t "=$name" -F '  #{window_index}: #{window_name}  (#{window_panes} panes)' 2>/dev/null
    printf '\nctrl-x closes it.\n'
  elif ws=$(workspace_file "$path"); then
    printf 'Enter opens it with its workspace file (%s):\n\n' "${ws/#"$HOME"/\~}"
    if have bat; then bat --style=plain --color=always --language=ini "$ws"; else cat "$ws"; fi
    printf '\nctrl-e edits that file.\n'
  else
    printf 'Not open. Enter opens it in tmux:\n  left:  %s\n  right: nvim\n\n' "$(left_pane)"
    printf 'ctrl-n sets up a workspace file instead: your own tabs and panes\nfor this project (dev init).\n'
  fi
  if [[ -d $path/.git || -f $path/.git ]]; then
    printf '\n\033[2m%s\033[0m\n' "$(git -C "$path" log -1 --format='last commit %cr: %s' 2>/dev/null)"
  fi
}
left_pane() { local a; a=$(agent_cmd 2>/dev/null || true); if [[ -n $a ]]; then printf 'your agent (%s)' "$a"; else printf 'a shell (no agent set: dev agent set <cmd>)'; fi; }
PICK_COLORS='bg+:#3c3836,bg:-1,hl:#83a598,fg:#ebdbb2,header:#a89984,info:#fabd2f,pointer:#8ec07c,prompt:#fabd2f,hl+:#83a598,border:#504945'
# The preview fits the space: beside the list when wide, below it when tall
# enough, hidden when small (ctrl-/ toggles it). Re-checked on every resize.
PREVIEW_FIT='if [ "$FZF_COLUMNS" -ge 100 ]; then echo "change-preview-window:right,45%,border-left,wrap,noinfo"; elif [ "$FZF_LINES" -ge 24 ]; then echo "change-preview-window:down,40%,border-top,wrap,noinfo"; else echo "change-preview-window:hidden"; fi'
# options spelled out, so it looks the same in a tmux popup as in a shell
pick() { fzf --height=100% --layout=reverse --border=none --info=hidden --no-scrollbar --gutter=' ' --color="$PICK_COLORS" "$@"; }

# A typed path (~/x, /x, ./x) that's a folder: open exactly that folder.
typed_dir() { # query -> absolute folder, or nothing
  local q=$1
  # shellcheck disable=SC2088  # a literal ~ the user typed, expanded by hand
  case $q in "~"|"~/"*) q=$HOME${q#\~} ;; /*|./*|../*) ;; *) return 1 ;; esac
  [[ -d $q ]] && (cd "$q" && pwd -P)
}

cmd_ls() {
  have fzf || die "fzf isn't installed"
  local out query key line kind name path dir mark
  # marks whether the folders are loaded, so typing reloads only once
  mark=$(mktemp "${TMPDIR:-/tmp}/dev-pick.XXXXXX"); rm -f "$mark"
  trap 'rm -f "$mark"' RETURN
  local self; self="bash $(printf %q "$0")"
  local on_change="if [ -n \"\$FZF_QUERY\" ]; then [ -e $mark ] || { : > $mark; echo \"reload($self _items --all)\"; }; else rm -f $mark; echo \"reload($self _items)\"; fi"
  while :; do
    # enter with nothing matching still returns what was typed (a path, maybe)
    # ranked by match; equal matches keep list order (projects, then shallow folders)
    out=$(picker_items | pick --ansi --delimiter='\t' --with-nth=1 --tiebreak=index \
          --prompt='project> ' --print-query --bind 'enter:accept-or-print-query' \
          --header=$'Your projects. Type to search every folder in ~ (or a path)\nenter open · ^x close · ^e/^n workspace · ^/ preview' \
          --bind "change:transform:$on_change" \
          --header-first \
          --preview="bash $(printf %q "$0") _preview {2} {3} {4}" --preview-window='right,45%,border-left,wrap,noinfo' \
          --bind "start,resize:transform:$PREVIEW_FIT" --bind 'ctrl-/:toggle-preview' \
          --expect=ctrl-e,ctrl-x,ctrl-n) || return 0
    query=$(sed -n 1p <<<"$out"); key=$(sed -n 2p <<<"$out"); line=$(sed -n 3p <<<"$out")
    # a typed path wins over whatever it happened to match
    if [[ -z $key ]] && dir=$(typed_dir "$query"); then open_project "$dir"; return; fi
    [[ -n $line ]] || return 0
    IFS=$'\t' read -r _ kind name path <<<"$line"
    case $key in
      ctrl-e) (cd "$path" && cmd_edit) ;;
      ctrl-x) if [[ $kind == run ]]; then tmux kill-session -t "=$name" 2>/dev/null && ok "closed $name"; fi ;;
      ctrl-n) (cd "$path" && cmd_init) ;;
      *) [[ -d $path ]] || die "$path doesn't exist"
         # a plain folder opens as itself, a project at its repo's root
         if [[ $kind == folder ]]; then open_project "$path"; else open_project "$(project_root "$path")"; fi ;;
    esac
    return
  done
}

# ------------------------------------------------------------- worktrees ------
cmd_wt() {
  local sub=${1:-}; (($#)) && shift
  local root; root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repo"
  # worktrees live next to the main checkout
  local main; main=$(git -C "$root" worktree list --porcelain | awk '/^worktree /{print $2; exit}')
  local base; base="$(dirname "$main")/$(basename "$main").wt"
  case $sub in
    ls) git -C "$main" worktree list ;;
    rm)
      local br=${1:-}; [[ -n $br ]] || die "usage: dev wt rm <branch>"
      local path="$base/$br"
      [[ -d $path ]] || die "no worktree at $path"
      [[ -z $(git -C "$path" status --porcelain) ]] || die "$br has uncommitted changes; commit or stash first"
      local w; w=$(tmux list-windows -a -F '#{session_name}:#{window_index} #{pane_current_path}' 2>/dev/null | awk -v p="$path" '$2==p || index($2, p "/")==1 {print $1}' | sort -u)
      git -C "$main" worktree remove "$path"
      [[ -n $w ]] && while IFS= read -r t; do tmux kill-window -t "$t" 2>/dev/null || true; done <<<"$w"
      ok "removed worktree $br" ;;
    ''|-*) die "usage: dev wt <branch> | dev wt ls | dev wt rm <branch>" ;;
    *)
      local br=$sub path="$base/$sub"
      if [[ ! -d $path ]]; then
        mkdir -p "$base"
        if git -C "$main" show-ref --verify --quiet "refs/heads/$br"; then git -C "$main" worktree add "$path" "$br"
        else git -C "$main" worktree add -b "$br" "$path"; fi
      fi
      local session; session=$(session_name "$main")
      tmux has-session -t "=$session" 2>/dev/null || default_workspace | build_session "$session" "$main"
      local win="wt:${br//[.:]/_}"
      if ! tmux list-windows -t "=$session" -F '#{window_name}' | grep -qxF "$win"; then
        tmux new-window -d -t "$session:" -n "$win" -c "$path"
        tmux split-window -d -h -t "$session:$win" -c "$path"
        tmux set-window-option -t "$session:$win" main-pane-width '40%' >/dev/null 2>&1
        tmux select-layout -t "$session:$win" main-vertical >/dev/null
        local panes; mapfile -t panes < <(tmux list-panes -t "$session:$win" -F '#{pane_id}')
        pane_run "${panes[0]}" agent
        pane_run "${panes[1]}" nvim
      fi
      tmux select-window -t "$session:$win"
      attach "$session" ;;
  esac
}

# ------------------------------------------------------------- main -----------
cmd_help() {
  cat <<EOF
${B}dev${N}: tmux workspaces

  ${B}dev${N} [dir]               open this project's workspace (or the picker, outside a project)
  ${B}dev ls${N}                  pick a project or open session (also: prefix f, Alt-p);
                          every folder under ~ is in it too, or type a path
  ${B}dev init${N} [template] [--local|--repo]   create a workspace (.dev) here; templates: $(ls "$TEMPLATES" 2>/dev/null | tr '\n' ' ')
  ${B}dev edit${N}                edit this project's workspace
  ${B}dev agent${N} [set <cmd> | unset]   the agent the 'agent' pane runs
  ${B}dev wt${N} <branch>         a worktree + window for parallel work; ${B}dev wt ls${N}, ${B}dev wt rm${N} <branch>
  ${B}dev forget${N} [dir]        drop a project from the picker
  options: --agent <cmd> (this time only), --no-agent

  A workspace file: each [name] is a window (optional tmux layout after it:
  main-vertical, main-horizontal, even-horizontal, even-vertical, tiled);
  each line under it is a pane's command. 'agent' = your agent, 'shell' = a plain shell.
EOF
}

main() {
  local args=()
  while (($#)); do
    case $1 in
      --agent) DEV_AGENT_OVERRIDE=${2:-}; shift ;;
      --no-agent) DEV_NO_AGENT=1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- "${args[@]+"${args[@]}"}"
  local cmd=${1:-}
  case $cmd in
    ls|pick) cmd_ls ;;
    init) shift; cmd_init "$@" ;;
    edit) shift; cmd_edit "$@" ;;
    agent) shift; cmd_agent "$@" ;;
    wt) shift; cmd_wt "$@" ;;
    forget) shift; cmd_forget "$@" ;;
    _preview) shift; cmd_preview "$@" ;;
    _items) shift; picker_items "$@" ;;
    help|-h|--help) cmd_help ;;
    '')
      # In a project (a git repo, or a folder with a workspace): open it.
      # Anywhere else (e.g. ~): the picker.
      local root; root=$(project_root "$PWD")
      if [[ $root != "$HOME" ]] && { git -C "$PWD" rev-parse >/dev/null 2>&1 || workspace_file "$root" >/dev/null; }; then
        open_project "$root"
      else
        cmd_ls
      fi ;;
    *)
      [[ -d $cmd ]] || die "no such directory or command: $cmd (dev help)"
      open_project "$(project_root "$cmd")" ;;
  esac
}
main "$@"
