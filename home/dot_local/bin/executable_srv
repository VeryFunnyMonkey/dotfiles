#!/usr/bin/env bash
# srv: mount your servers' home folders at ~/Servers/<host>, over SSH.
# rclone does the mounting: `rclone mount` (FUSE, built into Linux) on Linux,
# `rclone nfsmount` (macOS's own NFS client, no macFUSE) on macOS. It goes
# through your normal ssh, so ~/.ssh/config, keys, the agent and known_hosts
# all apply. Run `srv help`.
set -euo pipefail

SRV_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/srv"
HOSTS="$SRV_CFG/hosts"
MNT_ROOT="$HOME/Servers"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/srv"
LOGS="${XDG_STATE_HOME:-$HOME/.local/state}/srv"
# What's mounted lives in a runtime folder, which is cleared at logout/reboot,
# exactly when the mounts go away too.
if [[ $(uname) == Darwin ]]; then RUNTIME="${TMPDIR:-/tmp}/srv"
else RUNTIME="${XDG_RUNTIME_DIR:-/tmp/srv-$(id -u)}/srv"; fi
MOUNTED="$RUNTIME/mounted"
PATH="$HOME/.local/bin:$PATH"
for _b in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x $_b ]] && ! command -v brew >/dev/null 2>&1; then eval "$("$_b" shellenv)"; fi
done
unset _b

if [[ -t 1 ]]; then B=$'\e[1m' DIM=$'\e[2m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m'; else B='' DIM='' G='' Y='' R='' N=''; fi
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*" >&2; }
bad()  { printf '  %s✗%s %s\n' "$R" "$N" "$*"; }
die()  { printf '%ssrv:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
darwin() { [[ $(uname) == Darwin ]]; }

# ------------------------------------------------------------- hosts ----------
# hosts file: name TAB user@host[:port] TAB path (~ = home) TAB source (manual|import)
hosts_init() { mkdir -p "$SRV_CFG"; [[ -f $HOSTS ]] || printf '# srv hosts: name<TAB>user@host[:port]<TAB>path (~ = home)<TAB>source\n' >"$HOSTS"; }
host_line() { awk -F'\t' -v n="$1" '$1==n && $1 !~ /^#/ {print; exit}' "$HOSTS" 2>/dev/null; }
host_names() { awk -F'\t' '$1 !~ /^#/ && NF>=2 {print $1}' "$HOSTS" 2>/dev/null; }
host_target() { host_line "$1" | cut -f2; }
host_path() { host_line "$1" | cut -f3; }
need_host() { [[ -n $(host_line "${1:-}") ]] || die "no host '${1:-}' (srv ls, srv add)"; }

# user@host[:port] -> ssh arguments
ssh_args() {
  local t=$1 port=''
  if [[ $t == *:* ]]; then port=${t##*:}; t=${t%:*}; fi
  printf '%s\n' -o ServerAliveInterval=15 -o ServerAliveCountMax=3
  if [[ -n $port ]]; then printf '%s\n' -p "$port"; fi
  printf '%s\n' "$t"
}

# ------------------------------------------------------------- mounts ---------
mount_point() { printf '%s/%s' "$MNT_ROOT" "$1"; }
is_mounted() { # path
  if darwin; then mount | grep -q " on $1 ("
  else grep -q " $1 fuse" /proc/mounts 2>/dev/null; fi
}
state_add() { mkdir -p "$RUNTIME"; touch "$MOUNTED"; grep -qxF "$1" "$MOUNTED" || printf '%s\n' "$1" >>"$MOUNTED"; }
state_del() { [[ -f $MOUNTED ]] || return 0; grep -vxF "$1" "$MOUNTED" >"$MOUNTED.new" || true; mv "$MOUNTED.new" "$MOUNTED"; }
# Mounted hosts, checked against the real mount table (stale entries dropped).
mounted_hosts() {
  [[ -f $MOUNTED ]] || return 0
  local n
  while IFS= read -r n; do
    [[ -n $n ]] || continue
    if is_mounted "$(mount_point "$n")"; then printf '%s\n' "$n"; else state_del "$n"; fi
  done < <(cat "$MOUNTED")
}
rclone_pid() { pgrep -f "rclone (nfs)?mount .* $1( |$)" 2>/dev/null | head -n1 || true; }

# Make sure ssh can log in without a prompt (rclone runs in the background).
# If the key needs its passphrase, ask once; the agent keeps it (AddKeysToAgent).
ssh_ready() { # name
  local -a a; mapfile -t a < <(ssh_args "$(host_target "$1")")
  ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new "${a[@]}" true 2>/dev/null && return 0
  { : </dev/tty; } 2>/dev/null || return 1   # no terminal to ask in
  printf '  %s: unlocking your key / accepting the host key (once)\n' "$1"
  ssh -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new "${a[@]}" true </dev/tty || return 1
}

cmd_mount() {
  local n=${1:-} path=${2:-}
  need_host "$n"
  have rclone || die "rclone isn't installed (rig sync)"
  local mp; mp=$(mount_point "$n")
  if is_mounted "$mp"; then state_add "$n"; ok "$n is already mounted at ${mp/#$HOME/~}"; return 0; fi
  # rclone: a relative path is relative to the login's home; blank is the home itself
  [[ -n $path ]] || path=$(host_path "$n")
  # shellcheck disable=SC2088  # the server's ~, not ours
  case $path in
    '~' | '~/') path='' ;;
    '~/'*) path=${path#\~/} ;;
  esac
  ssh_ready "$n" || die "can't log in to $n over ssh (srv ssh $n to check)"
  mkdir -p "$mp" "$CACHE/$n" "$LOGS"
  local -a a; mapfile -t a < <(ssh_args "$(host_target "$n")")
  local sshcmd="ssh -o BatchMode=yes ${a[*]}"
  local -a common=(
    ":sftp:$path" "$mp"
    --sftp-ssh "$sshcmd" --sftp-shell-type unix
    --vfs-cache-mode writes --vfs-write-back 1s --dir-cache-time 5s --attr-timeout 1s
    --cache-dir "$CACHE/$n" --log-file "$LOGS/$n.log" --log-level NOTICE
    --daemon
  )
  if darwin; then
    rclone nfsmount "${common[@]}" || die "mount failed (see ${LOGS/#$HOME/~}/$n.log)"
  else
    rclone mount "${common[@]}" --volname "$n" || die "mount failed (see ${LOGS/#$HOME/~}/$n.log)"
  fi
  local _; for _ in $(seq 1 20); do is_mounted "$mp" && break; sleep 0.25; done
  is_mounted "$mp" || die "rclone started but nothing is mounted (see ${LOGS/#$HOME/~}/$n.log)"
  state_add "$n"
  ok "mounted $n at ${mp/#$HOME/~}"
}

unmount_once() {
  if darwin; then umount "$1" 2>/dev/null
  else fusermount3 -u "$1" 2>/dev/null || fusermount -u "$1" 2>/dev/null; fi
}
unmount_force() {
  if darwin; then umount -f "$1" 2>/dev/null || diskutil unmount force "$1" >/dev/null 2>&1 || true
  else fusermount3 -uz "$1" 2>/dev/null || fusermount -uz "$1" 2>/dev/null || true; fi
}
users_of() { # what has the mount open
  if have lsof; then lsof +D "$1" 2>/dev/null | awk 'NR>1 {print "    " $1 " (pid " $2 ")"}' | sort -u | head -n 8
  elif have fuser; then fuser -vm "$1" 2>&1 | sed 's/^/    /' | head -n 8; fi
}
say_hint() { printf '    %s%s%s\n' "$DIM" "$*" "$N"; }

cmd_umount() {
  local force=0 all=0 names=()
  while (($#)); do case $1 in --force|-f) force=1 ;; --all|-a) all=1 ;; *) names+=("$1") ;; esac; shift; done
  if ((all)); then mapfile -t names < <( { mounted_hosts; [[ -f $MOUNTED ]] && cat "$MOUNTED"; } | sort -u); fi
  ((${#names[@]})) || die "usage: srv umount <host>... | --all [--force]"
  local n mp pid
  for n in "${names[@]}"; do
    [[ -n $n ]] || continue
    mp=$(mount_point "$n")
    if is_mounted "$mp"; then
      # programs that just closed (an editor's language server, say) can take
      # a moment to let go, so try a few times before calling it busy

      local _; for _ in 1 2 3 4 5 6; do
        unmount_once "$mp" && break
        if ((force)); then unmount_force "$mp"; break; fi
        sleep 0.5
      done
      pid=$(rclone_pid "$mp")
      if [[ -n $pid ]] && ((force)); then kill "$pid" 2>/dev/null || true; fi
    fi
    if is_mounted "$mp"; then
      bad "$n is busy: something still has files open in ${mp/#$HOME/~}"
      users_of "$mp"
      say_hint "close them, or: srv umount --force $n"
      continue
    fi
    state_del "$n"
    rmdir "$mp" 2>/dev/null || true
    ok "unmounted $n"
  done
  rmdir "$MNT_ROOT" 2>/dev/null || true
}

# ------------------------------------------------------------- add / rm -------
ask() { # prompt [default]
  local r
  if have gum; then gum input --prompt "$1: " --value "${2:-}" </dev/tty
  else printf '  %s%s: ' "$1" "${2:+ [$2]}" >/dev/tty; IFS= read -r r </dev/tty; printf '%s' "${r:-${2:-}}"; fi
}
cmd_add() {
  hosts_init
  local n=${1:-} t=${2:-} p=${3:-}
  [[ -n $n ]] || n=$(ask "Name (used for ~/Servers/<name>)")
  n=$(printf '%s' "$n" | tr 'A-Z ' 'a-z-' | tr -cd 'a-z0-9._-')
  [[ -n $n ]] || die "need a name"
  [[ -z $(host_line "$n") ]] || die "'$n' already exists (srv edit to change it)"
  [[ -n $t ]] || t=$(ask "Login (user@host, or user@host:port)" "$(id -un)@$n")
  [[ $t == *@* ]] || die "the login is user@host"
  [[ $# -ge 3 ]] || p=$(ask "Folder to mount (blank = the home folder)" "")
  printf '%s\t%s\t%s\t%s\n' "$n" "$t" "${p:-~}" manual >>"$HOSTS"
  ok "added $n ($t${p:+, $p})"
  if ssh_ready "$n"; then ok "ssh login works"; else warn "couldn't log in yet; check with: srv ssh $n"; fi
}
cmd_rm() {
  local n=${1:-}; need_host "$n"
  if is_mounted "$(mount_point "$n")"; then cmd_umount "$n"; fi
  awk -F'\t' -v n="$n" '$1!=n' "$HOSTS" >"$HOSTS.new" && mv "$HOSTS.new" "$HOSTS"
  ok "removed $n"
}

# ------------------------------------------------------------- list / status --
cmd_ls() {
  hosts_init
  local mounted; mounted=$(mounted_hosts)
  local n t p s any=0
  while IFS=$'\t' read -r n t p s; do
    [[ -z $n || $n == \#* ]] && continue
    any=1
    if grep -qxF "$n" <<<"$mounted"; then printf '  %s●%s %-18s %-32s %s%s\n' "$G" "$N" "$n" "$t" "${p:-~}" "$([[ $s == import || $s == homelab ]] && echo "  ${DIM}imported${N}")"
    else printf '  ○ %-18s %-32s %s%s\n' "$n" "$t" "${p:-~}" "$([[ $s == import || $s == homelab ]] && echo "  ${DIM}imported${N}")"; fi
  done <"$HOSTS"
  ((any)) || echo "  no hosts yet: srv add, or srv import <hosts file>"
}
# For the prompt and tmux: mounted host names, or nothing.
cmd_status() {
  local m; m=$(mounted_hosts | tr '\n' ' '); m=${m% }
  [[ -n $m ]] || return 0
  case ${1:-} in
    --tmux) printf '#[fg=yellow]⇅ %s ' "$m" ;;
    *) printf '%s\n' "$m" ;;
  esac
}

# ------------------------------------------------------------- picker ---------
cmd_pick() {
  have fzf || die "fzf isn't installed"
  hosts_init
  local mounted; mounted=$(mounted_hosts)
  local lines='' n t p s
  while IFS=$'\t' read -r n t p s; do
    [[ -z $n || $n == \#* ]] && continue
    if grep -qxF "$n" <<<"$mounted"; then lines+="●"$'\t'"$n"$'\t'"$t"$'\t'"${p:-~}"$'\n'
    else lines+="○"$'\t'"$n"$'\t'"$t"$'\t'"${p:-~}"$'\n'; fi
  done <"$HOSTS"
  if [[ -z $lines ]]; then lines="+"$'\t'"(add a host)"$'\t'$'\t'$'\n'; fi
  local out key line mark
  out=$(printf '%s' "$lines" | fzf --ansi --delimiter='\t' --no-sort --prompt='server> ' \
        --header='enter mount/unmount · ctrl-d dev workspace · ctrl-s ssh · ctrl-a add · ctrl-e edit · ctrl-x unmount' \
        --preview="$0 _preview {2}" --preview-window=right,45% \
        --expect=ctrl-d,ctrl-s,ctrl-a,ctrl-e,ctrl-x) || return 0
  key=$(head -n1 <<<"$out"); line=$(sed -n 2p <<<"$out")
  IFS=$'\t' read -r mark n _ <<<"$line"
  case $key in
    ctrl-a) cmd_add ;;
    ctrl-e) "${EDITOR:-nvim}" "$HOSTS" ;;
    ctrl-d) [[ $mark == + ]] || cmd_dev "$n" ;;
    ctrl-s) [[ $mark == + ]] || cmd_ssh "$n" ;;
    ctrl-x) [[ $mark == ● ]] && cmd_umount "$n" ;;
    *)
      if [[ $mark == + ]]; then cmd_add
      elif [[ $mark == ● ]]; then cmd_umount "$n"
      else cmd_mount "$n"; fi ;;
  esac
}
cmd_preview() {
  local n=$1 mp; [[ -n $(host_line "$n") ]] || { echo "add a host: user@host, and a folder (blank = home)"; return; }
  mp=$(mount_point "$n")
  printf '%s\n\n  login   %s\n  folder  %s\n  mount   %s\n' "$n" "$(host_target "$n")" "$(host_path "$n" | sed 's/^~$/~ (home)/')" "${mp/#$HOME/~}"
  if is_mounted "$mp"; then
    printf '\n  ● mounted\n\n'; ls -1 "$mp" 2>/dev/null | head -n 20 | sed 's/^/    /'
  else printf '\n  ○ not mounted (enter mounts it)\n'; fi
}

# ------------------------------------------------------------- ssh / dev ------
cmd_ssh() {
  local n=${1:-}; need_host "$n"; shift
  [[ ${1:-} == -- ]] && shift
  local -a a; mapfile -t a < <(ssh_args "$(host_target "$n")")
  exec ssh "${a[@]}" "$@"
}
cmd_dev() {
  local n=${1:-}; need_host "$n"
  is_mounted "$(mount_point "$n")" || cmd_mount "$n"
  exec dev "$(mount_point "$n")"
}

# ------------------------------------------------------------- import ---------
# Import hosts from a file: srv's simple list (name user@host[:port] [path] per
# line; see extras/srv-hosts.example) or an Ansible inventory (hosts.yml, with
# group_vars/host_vars next to it for ansible_user / ansible_host). Imported
# hosts are marked source=import; re-importing replaces only those.
IMPORT_SRC() { printf '%s/import-source' "$SRV_CFG"; }

inventory_hosts() { # inventory.yml
  awk '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    {
      match($0, /^ */); ind = RLENGTH
      line = $0; sub(/^ */, "", line); sub(/[[:space:]]*#.*/, "", line)
      if (in_hosts && ind <= hosts_ind) in_hosts = 0
      if (line == "hosts:") { in_hosts = 1; hosts_ind = ind; next }
      if (in_hosts && line ~ /^[A-Za-z0-9._-]+:$/ && ind == hosts_ind + 2) { sub(/:$/, "", line); print line }
    }' "$1" | sort -u
}
yaml_value() { # file key
  [[ -f $1 ]] || return 0
  awk -v k="$2" '$1==k":" {sub(/^[^:]*:[[:space:]]*/,""); gsub(/["'"'"']/,""); print; exit}' "$1"
}
host_vars_file() { # inventory-dir host
  local f
  for f in "$1/host_vars/$2.yml" "$1/host_vars/$2.yaml" "$1/host_vars/$2/main.yml" "$1/host_vars/$2/main.yaml"; do
    if [[ -f $f ]]; then printf '%s' "$f"; return; fi
  done
}
group_all_file() {
  local f
  for f in "$1/group_vars/all.yml" "$1/group_vars/all.yaml" "$1/group_vars/all/main.yml" "$1/group_vars/all/main.yaml"; do
    if [[ -f $f ]]; then printf '%s' "$f"; return; fi
  done
}

# file or folder -> the file to read (an inventory folder holds hosts.yml / inventory.yml)
import_file() {
  local p=${1/#\~/$HOME}
  if [[ -d $p ]]; then
    local f
    for f in "$p/hosts.yml" "$p/hosts.yaml" "$p/inventory.yml" "$p/inventory/hosts.yml" "$p/inventory/hosts.yaml"; do
      if [[ -f $f ]]; then printf '%s' "$f"; return; fi
    done
    return 1
  fi
  [[ -f $p ]] && printf '%s' "$p"
}

cmd_import() {
  local arg=${1:-}
  if [[ -z $arg ]]; then
    [[ -f $(IMPORT_SRC) ]] || die "usage: srv import <hosts file | Ansible inventory> (example: extras/srv-hosts.example in the dotfiles)"
    arg=$(cat "$(IMPORT_SRC)")
  fi
  local file; file=$(import_file "$arg") || die "no hosts file at $arg"
  [[ -n $file ]] || die "no hosts file at $arg"
  hosts_init
  local tmp n=0 name target path
  tmp=$(mktemp)
  awk -F'\t' '$4!="import" && $4!="homelab"' "$HOSTS" >"$tmp"
  add_host() { # name target path
    if [[ -n $(awk -F'\t' -v n="$1" '$1==n' "$tmp") ]]; then warn "$1: you already have your own entry; kept yours"; return; fi
    printf '%s\t%s\t%s\timport\n' "$1" "$2" "${3:-~}" >>"$tmp"; n=$((n + 1))
  }
  if grep -qE '^[[:space:]]*hosts:[[:space:]]*$' "$file"; then
    # Ansible inventory
    local dir def_user user addr h hv
    dir=$(dirname "$file")
    def_user=$(yaml_value "$(group_all_file "$dir")" ansible_user); def_user=${def_user:-$(id -un)}
    while IFS= read -r h; do
      [[ -n $h ]] || continue
      hv=$(host_vars_file "$dir" "$h")
      user=$(yaml_value "$hv" ansible_user); user=${user:-$def_user}
      addr=$(yaml_value "$hv" ansible_host); addr=${addr:-$h}
      add_host "$h" "$user@$addr" "~"
    done < <(inventory_hosts "$file")
  else
    # simple list: name user@host[:port] [path]
    while read -r name target path _; do
      [[ -z $name || $name == \#* ]] && continue
      [[ $target == *@* ]] || { warn "skipped '$name': the login must be user@host"; continue; }
      add_host "$name" "$target" "$path"
    done <"$file"
  fi
  mv "$tmp" "$HOSTS"
  printf '%s\n' "$file" >"$(IMPORT_SRC)"
  ok "imported $n hosts from ${file/#$HOME/~} (srv ls; srv import again re-reads it)"
}

# ------------------------------------------------------------- doctor ---------
cmd_doctor() {
  local fails=0
  if have rclone; then ok "rclone $(rclone version 2>/dev/null | head -n1 | awk '{print $2}')"; else bad "rclone missing (rig sync)"; fails=1; fi
  if ! darwin; then
    if have fusermount3 || have fusermount; then ok "FUSE"; else bad "fuse3 missing (rig sync)"; fails=1; fi
  fi
  local m; m=$(mounted_hosts | tr '\n' ' ')
  ok "mounted: ${m:-none}"
  local n
  for n in $(host_names); do
    local mp; mp=$(mount_point "$n")
    # stale: still in the mount table, but its rclone is gone (e.g. killed, or the
    # machine slept through a network change)
    if is_mounted "$mp" && [[ -z $(rclone_pid "$mp") ]]; then
      bad "$n: stale mount (srv umount --force $n)"; fails=1
    fi
  done
  ((fails == 0))
}

cmd_help() {
  cat <<EOF
${B}srv${N}: mount your servers at ~/Servers/<host>, over SSH

  ${B}srv${N}                        pick a host (also: prefix m in tmux, Alt-m)
  ${B}srv mount${N} <host> [path]    mount its home folder (or a path)
  ${B}srv umount${N} <host> | --all  unmount (--force for a stuck mount)
  ${B}srv dev${N} <host>             mount it and open a dev workspace there (agent + nvim)
  ${B}srv ssh${N} <host> [-- cmd]    a shell (or a command) on the server
  ${B}srv add${N} [name user@host[:port] [path]]   add a host
  ${B}srv rm${N} <host> · ${B}srv edit${N} · ${B}srv ls${N}
  ${B}srv import${N} [file]          add hosts from a hosts file or an Ansible inventory (re-reads the last one)
  ${B}srv doctor${N}                 check rclone/FUSE and stale mounts
EOF
}

main() {
  local cmd=${1:-}; (($#)) && shift
  case $cmd in
    '') cmd_pick ;;
    mount|m) cmd_mount "$@" ;;
    umount|unmount|u) cmd_umount "$@" ;;
    add) cmd_add "$@" ;;
    rm|remove) cmd_rm "$@" ;;
    edit) hosts_init; "${EDITOR:-nvim}" "$HOSTS" ;;
    ls|list) cmd_ls ;;
    dev) cmd_dev "$@" ;;
    ssh) cmd_ssh "$@" ;;
    import|import-homelab) cmd_import "$@" ;;
    doctor) cmd_doctor ;;
    _status) cmd_status "$@" ;;
    _preview) cmd_preview "$@" ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown command '$cmd' (srv help)" ;;
  esac
}
main "$@"
