# Templated: files only some machines get.
{{- if ne .chezmoi.os "darwin" }}
Library/**
{{- end }}

{{- /* files that belong to a catalog item: only when it's selected */ -}}
{{- $en := includeTemplate "enabled" . | fromJson }}
{{- if not (has "ghostty" $en.selected) }}
.config/ghostty
.config/ghostty/**
{{- end }}
{{- if not (and (has "wm" $en.selected) (eq .chezmoi.os "darwin")) }}
.config/aerospace
.config/aerospace/**
{{- end }}
