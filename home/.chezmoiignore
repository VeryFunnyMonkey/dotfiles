# Templated: files only some machines get.
{{- if ne .chezmoi.os "darwin" }}
Library/**
{{- end }}

{{- /* Files that belong to a catalog item (its files: and files_<platform>:)
       are left out unless the item is selected (and, for files_<platform>,
       this is that platform). Declared in .chezmoidata/catalog/. */ -}}
{{- $d := includeTemplate "detect" . | fromJson }}
{{- $en := includeTemplate "enabled" . | fromJson }}
{{- range $id := keys .catalog | sortAlpha }}
{{-   $it := index $.catalog $id }}
{{-   $on := has $id $en.selected }}
{{-   range $key := keys $it | sortAlpha }}
{{-     $plat := "" }}{{- $isfiles := false }}
{{-     if eq $key "files" }}{{ $isfiles = true }}
{{-     else if hasPrefix "files_" $key }}{{ $isfiles = true }}{{ $plat = trimPrefix "files_" $key }}{{ end }}
{{-     if and $isfiles (or (not $on) (and $plat (ne $plat $d.platform) (ne $plat $d.target))) }}
{{-       range $f := index $it $key }}
{{ $f }}
{{ $f }}/**
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
