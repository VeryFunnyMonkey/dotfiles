#!/usr/bin/env bash
# Installs whatever is declared but missing. Re-runs whenever the declaration
# or the machine profile changes:
#   packages {{ list .packages .catalog .runtimes | toJson | sha256sum }}
#   profile  {{ list (dig "selected" list .) (dig "extra_packages" list .) .display .wsl | toJson | sha256sum }}
set -euo pipefail
exec {{ joinPath .chezmoi.destDir ".local/bin/rig" | quote }} sync
