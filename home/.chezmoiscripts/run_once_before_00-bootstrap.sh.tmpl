#!/usr/bin/env bash
# Prerequisites before anything else: git/curl and the package manager.
# Debian/Ubuntu and Fedora get Homebrew on Linux for developer tools; macOS
# gets Homebrew. Recorded in the ledger so `rig uninstall --runtimes` can undo it.
set -euo pipefail
{{- $platform := includeTemplate "platform" . | trim }}
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/rig"
mkdir -p "$STATE"; touch "$STATE/system.log"
sudo_() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi; }
have() { command -v "$1" >/dev/null 2>&1; }
record() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$(date +%Y-%m-%dT%H:%M:%S)" >>"$STATE/system.log"; }
touch "$STATE/packages.log"
# Note each prerequisite in the ledger (packages.log) before installing it, so
# `rig uninstall --packages` knows which ones were already there.
note_pkgs() { # manager present-check-cmd pkgs...
  local mgr=$1 check=$2 p; shift 2
  for p in "$@"; do
    awk -F'\t' -v m="$mgr" -v n="$p" '$1==m && $2==n {f=1} END {exit !f}' "$STATE/packages.log" && continue
    if $check "$p" >/dev/null 2>&1; then st=preexisting; else st=installed; fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$mgr" "$p" "$p" "$st" "$(date +%Y-%m-%dT%H:%M:%S)" >>"$STATE/packages.log"
  done
}
dpkg_has() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }

install_brew() {
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [[ -x $b ]] && return 0
  done
  echo "==> installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  record brew-installed homebrew -
}

{{- if eq $platform "arch" }}
note_pkgs pacman "pacman -Q" git curl
have git && have curl || sudo_ pacman -S --needed --noconfirm git curl
{{- else if eq $platform "debian" }}
PRE=(git curl ca-certificates build-essential procps file zsh)
note_pkgs apt dpkg_has "${PRE[@]}"
sudo_ apt-get update -qq
sudo_ env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${PRE[@]}"
install_brew
{{- else if eq $platform "fedora" }}
PRE=(git curl gcc make procps-ng file zsh)
note_pkgs dnf "rpm -q" "${PRE[@]}"
sudo_ dnf install -y -q "${PRE[@]}"
install_brew
{{- else if eq $platform "darwin" }}
install_brew
{{- else }}
echo "rig: unsupported platform ({{ .chezmoi.os }}); skipping package bootstrap" >&2
{{- end }}
