#!/usr/bin/env bash
# Prerequisites before anything else: git/curl and the package manager.
# Debian/Ubuntu and Fedora get Homebrew on Linux for developer tools; macOS
# gets Homebrew. Recorded in the ledger so `rig uninstall --runtimes` can undo it.
set -euo pipefail
export HOMEBREW_NO_ASK=1   # brew's own [y/n] (rig setup already asked)
{{- $platform := includeTemplate "platform" . | trim }}
# rig's own building blocks, straight from the repo (rig isn't applied yet):
# output, `have` and Homebrew on PATH (base), sudo_ (sys), where rig keeps its
# state (machine) and the ledger, so what this installs is recorded exactly
# the way rig reads it back.
# shellcheck disable=SC2034  # die's prefix, read by lib/base.sh
TOOL=rig
for _f in base sys machine ledger; do
  # shellcheck source=/dev/null
  source {{ joinPath .chezmoi.sourceDir "dot_local/share/rig/lib" | quote }}/$_f.sh
done
unset _f
ledger_init
# Note each prerequisite in the ledger (packages.log) before installing it, so
# `rig uninstall --packages` knows which ones were already there.
note_pkgs() { # manager present-check-cmd pkgs...
  local mgr=$1 check=$2 p st; shift 2
  for p in "$@"; do
    if $check "$p" >/dev/null 2>&1; then st=preexisting; else st=installed; fi
    ledger_pkg_record "$mgr" "$p" "$p" "$st"   # only the first time it's seen
  done
}
dpkg_has() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }

install_brew() {
  brew_env
  if have brew; then return 0; fi
  echo "==> installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  ledger_record brew-installed homebrew -
  brew_env
}

{{- if eq $platform "arch" }}
note_pkgs pacman "pacman -Q" git curl base-devel
have git && have curl && pacman -Q base-devel >/dev/null 2>&1 || sudo_ pacman -S --needed --noconfirm git curl base-devel
# The AUR helper (rig installs AUR items and updates with it): yay, unless yay
# or paru is already here. Built as yay-bin; only the main package is installed
# (makepkg may also build a -debug one).
if ! have yay && ! have paru; then
  echo "==> installing yay (the AUR helper)"
  note_pkgs pacman "pacman -Q" yay-bin
  tmp=$(mktemp -d)
  git clone -q --depth 1 https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
  (cd "$tmp/yay-bin" && makepkg -s --noconfirm --needed &&
    sudo_ pacman -U --noconfirm --needed "$(find . -maxdepth 1 -name 'yay-bin-[0-9]*.pkg.tar.*' | head -n1)")
  rm -rf "$tmp"
fi
{{- else if eq $platform "debian" }}
PRE=(git curl ca-certificates build-essential procps file zsh)
note_pkgs apt dpkg_has "${PRE[@]}"
# only what's missing: installing a present package would mark it manual
MISSING=(); for p in "${PRE[@]}"; do dpkg_has "$p" || MISSING+=("$p"); done
sudo_ apt-get update -qq   # later installs need fresh lists too
if ((${#MISSING[@]})); then
  sudo_ env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${MISSING[@]}"
fi
install_brew
{{- else if eq $platform "fedora" }}
PRE=(git curl gcc make procps-ng file zsh)
note_pkgs dnf "rpm -q" "${PRE[@]}"
MISSING=(); for p in "${PRE[@]}"; do rpm -q "$p" >/dev/null 2>&1 || MISSING+=("$p"); done
if ((${#MISSING[@]})); then sudo_ dnf install -y -q "${MISSING[@]}"; fi
install_brew
{{- else if eq $platform "darwin" }}
install_brew
# rig needs bash 4 or newer; macOS ships 3.2
note_pkgs brew "brew list --formula" bash
brew list --formula bash >/dev/null 2>&1 || brew install -q bash
{{- else }}
echo "rig: unsupported platform ({{ .chezmoi.os }}); skipping package bootstrap" >&2
{{- end }}
