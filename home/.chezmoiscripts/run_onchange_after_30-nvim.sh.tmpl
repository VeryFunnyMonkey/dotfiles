#!/usr/bin/env bash
# Neovim: plugins (from the committed lockfile), treesitter parsers, Mason
# tools (the nvim module). Re-runs when the lockfile or the selection changes:
#   lock    {{ include "dot_config/nvim/nvim-pack-lock.json" | sha256sum }}
#   items   {{ (includeTemplate "enabled" .) | sha256sum }}
set -euo pipefail
exec {{ joinPath .chezmoi.destDir ".local/bin/rig" | quote }} modules sync nvim
