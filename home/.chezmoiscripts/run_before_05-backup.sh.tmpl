#!/usr/bin/env bash
# Runs before every apply. Any file chezmoi is about to take over that existed
# before rig (and anything superseded, like ~/.zshrc or ~/.gitconfig) is copied
# into the ledger first, then moved out of the way, so `rig uninstall` can put
# it back exactly. Already-processed targets are skipped (ledger: seen).
set -euo pipefail
SRC={{ .chezmoi.sourceDir | quote }}
# rig's own building blocks, straight from the repo (rig isn't applied yet):
# the ledger writes the backup record, in the format uninstall reads back.
# shellcheck disable=SC2034  # die's prefix, read by lib/base.sh
TOOL=rig
for _f in base sys machine ledger; do
  # shellcheck source=/dev/null
  source "$SRC/dot_local/share/rig/lib/$_f.sh"
done
unset _f
ledger_init; touch "$RIG_STATE/seen" "$RIG_STATE/backup.manifest"
BK="$RIG_STATE/backup/$(date +%Y%m%d-%H%M%S)"

MOVED=()
save() { backup_save "$1" "$2" "$BK"; MOVED+=("$2"); }   # kind relpath
# where your own additions go now, for a moved file (.chezmoidata/local.yaml)
local_for() { # relpath -> "file|note"
  case $1 in
{{- range .local_files }}
    {{ range $i, $p := .paths }}{{ if $i }} | {{ end }}{{ $p | quote }}{{ if hasSuffix "/" $p }}*{{ end }}{{ end }}) printf '%s|%s' {{ .file | quote }} {{ dig "note" "" . | quote }} ;;
{{- end }}
    *) ;;
  esac
}

# A parent directory that is a symlink (e.g. an old Stow link) would make
# chezmoi write *through* it, so record it and replace it with a real folder.
fix_parents() {
  local rel=$1 path="" part
  local IFS=/
  for part in $(dirname "$rel"); do
    [[ $part == . ]] && continue
    path=${path:+$path/}$part
    if [[ -L $HOME/$path ]] && ! backup_seen "dir:$path"; then
      save dirlink "$path"
      rm "$HOME/$path"; mkdir -p "$HOME/$path"
      backup_mark "dir:$path"
    fi
  done
}

# What chezmoi manages on this machine (honours .chezmoiignore, so switched-off
# modules are left alone). A throwaway state file avoids the running apply's lock.
tmpstate=$(mktemp)
CZ=({{ .chezmoi.executable | quote }} --source "$SRC" --config {{ .chezmoi.configFile | quote }} \
  --destination "$HOME" --persistent-state "$tmpstate")
managed=$("${CZ[@]}" managed --include=files,symlinks --path-style=relative) || {
  rm -f "$tmpstate"
  echo "rig: couldn't list managed files; stopping before anything is overwritten" >&2
  exit 1
}

while IFS= read -r t; do
  [[ -z $t ]] && continue
  fix_parents "$t"
  backup_seen "$t" && continue
  if [[ -L $HOME/$t && $(readlink "$HOME/$t") == "$SRC"/* ]]; then backup_mark "$t"; continue; fi
  # Already exactly what chezmoi writes (e.g. applied earlier with scripts
  # skipped)? Then it's ours, not something to back up.
  if [[ -f $HOME/$t && ! -L $HOME/$t ]] && "${CZ[@]}" cat "$HOME/$t" 2>/dev/null | cmp -s - "$HOME/$t"; then
    backup_mark "$t"; continue
  fi
  if [[ -e $HOME/$t || -L $HOME/$t ]]; then
    save file "$t"
    rm -rf "${HOME:?}/$t"
  fi
  backup_mark "$t"
done <<<"$managed"
rm -f "$tmpstate"

# Files that would shadow this setup if left in place (zsh reads $ZDOTDIR,
# git reads ~/.config/git): backed up like the rest, so uninstall restores them.
# A ~/.gitconfig keeps working: rig's git config includes a copy of it
# first, so what rig doesn't set itself (a credential helper, aliases, url
# rewrites) still applies.
for t in .zshrc .zprofile .zlogin .zlogout .gitconfig .tmux.conf; do
  backup_seen "$t" && continue
  if [[ -e $HOME/$t || -L $HOME/$t ]]; then
    save file "$t"
    if [[ $t == .gitconfig ]]; then cp -L "$HOME/$t" "$RIG_STATE/gitconfig-before-rig" 2>/dev/null || true; fi
    rm -rf "${HOME:?}/$t"
  fi
  backup_mark "$t"
done

# Say what moved and where it went: nothing of yours disappears silently.
if ((${#MOVED[@]})); then
  echo "rig: moved aside (rig's versions are in their place now; rig uninstall puts yours back):"
  for t in "${MOVED[@]}"; do
    echo "  ~/$t  ->  ${BK/#$HOME/\~}/$t"
    w=$(local_for "$t")
    if [[ -n ${w#*|} ]]; then echo "      ${w#*|}"
    elif [[ -n $w ]]; then echo "      what you want back from it goes in ${w%%|*}"; fi
  done
fi
