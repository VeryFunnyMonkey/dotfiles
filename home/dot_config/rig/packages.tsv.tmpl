{{- /*
  This machine's resolved package list. One line per package:
    <manager> TAB <name(s)> TAB <logical> TAB <source> TAB <blocked by>
  <blocked by>: that manager's packages which, installed, keep this one out
  (packages.yaml conflicts).
  Sources: core, item:<id>, runtime:<name>, extra. Managers: pacman, aur, apt, dnf, brew, winget, download.
  The rules (virtual packages, downloads, per-manager names) are data in
  .chezmoidata/packages.yaml.
*/ -}}
{{- $p := .packages -}}
{{- $d := includeTemplate "detect" . | fromJson -}}
{{- $en := includeTemplate "enabled" . | fromJson -}}
{{- $native := "pacman" -}}
{{- if eq $d.platform "debian" }}{{ $native = "apt" }}{{ end -}}
{{- if eq $d.platform "fedora" }}{{ $native = "dnf" }}{{ end -}}
{{- $variant := $d.display -}}{{- if $d.wsl }}{{ $variant = "windows" }}{{ end -}}

{{- /* (package, source, logical name) triples; a virtual package expands to this machine's packages */ -}}
{{- $raw := list -}}
{{- range $pkg := $p.core -}}{{- $raw = append $raw (list $pkg "core") -}}{{- end -}}
{{- range $id := $en.selected -}}
{{-   $it := index $.catalog $id -}}
{{-   $pk := concat (dig "packages" list $it) (dig (printf "packages_%s" $d.platform) list $it) -}}
{{-   if ne $d.target $d.platform }}{{ $pk = concat $pk (dig (printf "packages_%s" $d.target) list $it) }}{{ end -}}
{{-   range $pkg := $pk -}}
{{-     $raw = append $raw (list $pkg (printf "item:%s" $id)) -}}
{{-   end -}}
{{- end -}}
{{- range $r := $en.runtimes -}}
{{-   range $pkg := (dig "packages" list (index $.runtimes $r)) -}}{{- $raw = append $raw (list $pkg (printf "runtime:%s" $r)) -}}{{- end -}}
{{- end -}}
{{- range $pkg := (dig "extra_packages" list .) -}}{{- $raw = append $raw (list $pkg "extra") -}}{{- end -}}
{{- $pairs := list -}}
{{- range $pair := $raw -}}
{{-   $pkg := index $pair 0 -}}
{{-   if hasKey $p.virtual $pkg -}}
{{-     range $real := (dig $variant list (index $p.virtual $pkg)) -}}{{- $pairs = append $pairs (list $real (index $pair 1) $pkg) -}}{{- end -}}
{{-   else -}}{{- $pairs = append $pairs (list $pkg (index $pair 1) $pkg) -}}{{- end -}}
{{- end -}}

{{- range $pair := $pairs -}}
{{-   $pkg := index $pair 0 -}}
{{-   $src := index $pair 1 -}}
{{-   $logical := index $pair 2 -}}
{{-   $mgr := "brew" -}}
{{-   if has $pkg $p.download_everywhere -}}{{- $mgr = "download" -}}
{{-   else if and $d.wsl (has $pkg $p.winget) -}}{{- $mgr = "winget" -}}
{{-   else if and (eq $d.platform "arch") (has $pkg $p.aur) -}}{{- $mgr = "aur" -}}
{{-   else if eq $d.platform "arch" -}}{{- $mgr = "pacman" -}}
{{-   else if eq $d.platform "darwin" -}}{{- $mgr = "brew" -}}
{{-   else if has $pkg $p.download -}}{{- $mgr = "download" -}}
{{-   else if has $pkg $p.native -}}{{- $mgr = $native -}}
{{-   end -}}
{{-   $name := $pkg -}}
{{-   if hasKey $p.names $mgr -}}
{{-     $map := index $p.names $mgr -}}
{{-     if hasKey $map $pkg }}{{ $name = index $map $pkg }}{{ end -}}
{{-   end -}}
{{-   if and (hasKey $p.only $pkg) (not (has $mgr (index $p.only $pkg))) -}}{{- $name = "-" -}}{{- end -}}
{{-   $blk := dig $pkg $mgr list (dig "conflicts" dict $p) -}}
{{-   if ne $name "-" }}
{{ $mgr }}	{{ $name }}	{{ $logical }}	{{ $src }}	{{ join " " $blk }}
{{-   end -}}
{{- end }}
