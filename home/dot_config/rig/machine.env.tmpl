# Written by chezmoi from the machine profile. Read by rig and dev. Don't edit;
# change answers with `rig profile`.
{{- $platform := includeTemplate "platform" . | trim }}
RIG_PLATFORM={{ $platform }}
RIG_PRESET={{ .preset }}
RIG_WORK={{ .work }}
RIG_GITHUB={{ .github }}
RIG_SESSION={{ .session }}
RIG_WSL={{ .wsl }}
RIG_DISPLAY={{ .display }}
{{- if eq $platform "arch" }}
RIG_NATIVE=pacman
{{- else if eq $platform "fedora" }}
RIG_NATIVE=dnf
{{- else if eq $platform "debian" }}
RIG_NATIVE=apt
{{- else if eq $platform "darwin" }}
RIG_NATIVE=brew
{{- else }}
RIG_NATIVE=none
{{- end }}
RIG_SOURCE_DIR={{ .chezmoi.sourceDir | quote }}
{{- $en := includeTemplate "enabled" . | fromJson }}
RIG_MODULES="{{ join " " $en.modules }}"
RIG_RUNTIMES="{{ join " " $en.runtimes }}"
RIG_AGENTS="{{ join " " $en.agents }}"
RIG_AGENT_DEFAULT={{ dig "agent_default" "" . | quote }}
