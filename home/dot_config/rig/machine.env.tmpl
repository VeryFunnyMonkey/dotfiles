# Written by chezmoi from the machine profile. Read by rig and dev. Don't edit;
# change choices with `rig setup`.
{{- $d := includeTemplate "detect" . | fromJson }}
{{- $en := includeTemplate "enabled" . | fromJson }}
RIG_PLATFORM={{ $d.platform }}
RIG_WSL={{ $d.wsl }}
RIG_DISPLAY={{ $d.display }}
RIG_DESKTOP={{ $d.desktop | quote }}
{{- if eq $d.platform "arch" }}
RIG_NATIVE=pacman
{{- else if eq $d.platform "fedora" }}
RIG_NATIVE=dnf
{{- else if eq $d.platform "debian" }}
RIG_NATIVE=apt
{{- else if eq $d.platform "darwin" }}
RIG_NATIVE=brew
{{- else }}
RIG_NATIVE=none
{{- end }}
RIG_SOURCE_DIR={{ .chezmoi.sourceDir | quote }}
RIG_PROFILE={{ dig "profile" "" . | quote }}
RIG_SELECTED="{{ join " " $en.selected }}"
RIG_SKIPPED="{{ range $i, $s := $en.skipped }}{{ if $i }} {{ end }}{{ $s.id }}{{ end }}"
RIG_RUNTIMES="{{ join " " $en.runtimes }}"
RIG_AGENTS="{{ join " " $en.agents }}"
RIG_ITEM_MODULES="{{ join " " $en.modules }}"
RIG_AGENT_DEFAULT={{ dig "agent_default" "" . | quote }}
RIG_EXTRA_PACKAGES="{{ join " " (dig "extra_packages" list .) }}"
