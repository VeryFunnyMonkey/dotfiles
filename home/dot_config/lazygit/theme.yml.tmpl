# Rendered from .chezmoidata/theme.yaml: lazygit's colours, loaded after
# config.yml (LG_CONFIG_FILE, set in zsh/theme.zsh). Edit the theme there.
gui:
  theme:
    activeBorderColor: ["{{ .theme.blue }}", bold]
    inactiveBorderColor: ["{{ .theme.bg2 }}"]
    selectedLineBgColor: ["{{ .theme.bg1 }}"]
    optionsTextColor: ["{{ .theme.blue }}"]
    cherryPickedCommitBgColor: ["{{ .theme.bg2 }}"]
    cherryPickedCommitFgColor: ["{{ .theme.aqua }}"]
    unstagedChangesColor: ["{{ .theme.red }}"]
