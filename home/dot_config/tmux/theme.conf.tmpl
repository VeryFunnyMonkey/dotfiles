# Rendered from .chezmoidata/theme.yaml. Edit the theme there, then `chezmoi apply`.
{{- $t := .theme }}
set -g status-style "bg=default,fg={{ $t.fg }}"
set -g window-status-style "fg={{ $t.gray }}"
set -g window-status-current-style "fg={{ $t.blue }},bold"
set -g window-status-bell-style "fg={{ $t.bg }},bg={{ $t.yellow }},bold"
set -g message-style "fg={{ $t.fg }},bg={{ $t.bg1 }}"
set -g mode-style "fg={{ $t.bg }},bg={{ $t.blue }}"
set -g pane-border-style "fg={{ $t.bg2 }}"
set -g pane-active-border-style "fg={{ $t.blue }}"
set -g popup-border-style "fg={{ $t.bg2 }}"
