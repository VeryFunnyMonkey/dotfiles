# Git preferences. No identity here: names, emails and keys are per account,
# machine-local, and written by `rig git add` into identities.gitconfig.
# Machine-local settings go in ~/.config/git/local.gitconfig (not
# `git config --global`, which would write into this file, in the repo).

# your ~/.gitconfig from before rig, first: everything below wins over it
[include]
	path = ~/.local/state/rig/gitconfig-before-rig

[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true          # n / N jump between files
	line-numbers = true
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[rebase]
	autoStash = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[help]
	autocorrect = prompt

# theme (rendered from theme.yaml), machine-local identities, then this
# machine's own settings (yours, and rig's items': Git Credential Manager on Windows)
[include]
	path = theme.gitconfig
[include]
	path = identities.gitconfig
[include]
	path = local.gitconfig
