# Ghostty: the terminal on Linux and macOS desktops. Plain file (symlinked from
# the repo); per-OS bits are in config-os, rendered by chezmoi.

font-family = JetBrainsMono Nerd Font
font-size = 12
theme = Gruvbox Dark

window-padding-x = 6
window-padding-y = 4
window-padding-balance = true
confirm-close-surface = false
# a steady cursor: calmer, and no redraw twice a second (battery)
cursor-style-blink = false

# Each window opens in tmux (see zshrc), which does tabs and splits: Ghostty's
# own tab and split keys are off (Linux ctrl+shift, macOS cmd) so there's one way.
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = super+t=unbind
keybind = super+d=unbind
keybind = super+shift+d=unbind

# clipboard: OSC52 from tmux and nvim (works over SSH too)
clipboard-read = allow
clipboard-write = allow
copy-on-select = false

# shell integration; over SSH, bring Ghostty's terminfo and environment along
# so servers understand the terminal
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

config-file = ?config-os
# this machine's own additions (not in the repo), last so they win
config-file = ?local
