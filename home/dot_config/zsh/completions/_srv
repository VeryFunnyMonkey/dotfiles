#compdef srv
local -a cmds hosts
cmds=(
  'mount:mount a host at ~/Servers/<host>'
  'umount:unmount (--all, --force)'
  'dev:mount and open a dev workspace there'
  'ssh:a shell or command on the server'
  'add:add a host'
  'rm:remove a host'
  'edit:edit the hosts file'
  'ls:list hosts'
  'import:add hosts from a hosts file or inventory'
  'doctor:check rclone, FUSE and stale mounts'
  'help:show help'
)
hosts=(${(f)"$(awk -F'\t' '$1 !~ /^#/ && NF>=2 {print $1}' ${XDG_CONFIG_HOME:-$HOME/.config}/srv/hosts 2>/dev/null)"})
if (( CURRENT == 2 )); then _describe 'srv command' cmds; return; fi
case $words[2] in
  mount|m|dev|ssh|rm|remove) (( CURRENT == 3 )) && _values 'host' $hosts ;;
  umount|unmount|u) _values -w 'host' $hosts --all --force ;;
  import|import-homelab) _files ;;
esac
