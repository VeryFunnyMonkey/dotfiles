# Rendered from .chezmoidata/theme.yaml. Edit the theme there, then `chezmoi apply`.
{{- $t := .theme }}
export RIG_PROMPT_FG={{ $t.prompt_fg }}
export RIG_PROMPT_BG1={{ $t.prompt_bg1 }}
export RIG_PROMPT_BG2={{ $t.prompt_bg2 }}

export BAT_THEME={{ $t.bat | quote }}
export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border --color={{ includeTemplate "fzf-colors" . }}"

# lazygit: its settings, then its colours (rendered from the theme)
export LG_CONFIG_FILE="$XDG_CONFIG_HOME/lazygit/config.yml,$XDG_CONFIG_HOME/lazygit/theme.yml"

# man pages through bat, when it's installed
if (( $+commands[bat] )); then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi
