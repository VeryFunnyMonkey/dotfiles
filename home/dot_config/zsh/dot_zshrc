# Interactive zsh. Environment is in ~/.zshenv, PATH in .zprofile.

# --- options -----------------------------------------------------------------
setopt auto_cd interactive_comments no_beep prompt_subst

# --- history -----------------------------------------------------------------
HISTFILE="$XDG_STATE_HOME/zsh/history"
[[ -d ${HISTFILE:h} ]] || mkdir -p "${HISTFILE:h}"
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space \
       hist_reduce_blanks hist_verify

# --- keys: emacs mode (chosen explicitly; EDITOR=nvim would otherwise pick vi)
bindkey -e
bindkey '^[[1;5C' forward-word         # Ctrl-Right
bindkey '^[[1;5D' backward-word        # Ctrl-Left
bindkey '^[[H' beginning-of-line       # Home
bindkey '^[[F' end-of-line             # End
bindkey '^[[3~' delete-char            # Delete
[[ -n ${terminfo[khome]} ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n ${terminfo[kend]}  ]] && bindkey "${terminfo[kend]}"  end-of-line
[[ -n ${terminfo[kdch1]} ]] && bindkey "${terminfo[kdch1]}" delete-char

# Ctrl-X Ctrl-E: edit the current command in nvim
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# --- completion --------------------------------------------------------------
fpath=("$ZDOTDIR/completions" $fpath)
autoload -Uz compinit
_zcompdump="$XDG_CACHE_HOME/zsh/zcompdump"
[[ -d ${_zcompdump:h} ]] || mkdir -p "${_zcompdump:h}"
# Full check at most once a day; otherwise trust the cached dump.
_stale=( $_zcompdump(N.mh+24) )
if [[ ! -f $_zcompdump ]] || (( ${#_stale} )); then
  compinit -d "$_zcompdump"
else
  compinit -C -d "$_zcompdump"
fi
unset _zcompdump _stale

zstyle ':completion:*' menu select
zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' completer _expand _complete _correct _approximate
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'

# --- the rest ----------------------------------------------------------------
for _f in theme aliases prompt plugins; do
  [[ -r $ZDOTDIR/$_f.zsh ]] && source "$ZDOTDIR/$_f.zsh"
done
unset _f

# Machine-local additions (not in the repo).
[[ -r $ZDOTDIR/local.zsh ]] && source "$ZDOTDIR/local.zsh"
