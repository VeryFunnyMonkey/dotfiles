# Interactive zsh. Environment is in ~/.zshenv, PATH in .zprofile.

# --- options -----------------------------------------------------------------
setopt auto_cd interactive_comments no_beep prompt_subst

# --- ssh agent without systemd -----------------------------------------------
# ~/.zshenv points at the systemd agent socket; Linux without a systemd user
# session (WSL without systemd, say) has none. When no agent answers (none
# set, or one that's gone): one ssh-agent per user on a fixed socket, started
# by the first shell and shared by the rest (and tmux).
if [[ $OSTYPE == linux* ]] && (( $+commands[ssh-agent] )); then
  ssh-add -l >/dev/null 2>&1
  if (( $? == 2 )); then   # 2: no agent there (1 is an agent with no keys yet)
    if [[ -n $XDG_RUNTIME_DIR && -d $XDG_RUNTIME_DIR && -O $XDG_RUNTIME_DIR ]]; then
      export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.zsh.sock"
    else
      [[ -d ~/.ssh ]] || mkdir -m 700 ~/.ssh
      export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
    fi
    ssh-add -l >/dev/null 2>&1
    if (( $? == 2 )); then
      rm -f "$SSH_AUTH_SOCK"
      ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null 2>&1 || unset SSH_AUTH_SOCK
    fi
  fi
fi

# --- history -----------------------------------------------------------------
HISTFILE="$XDG_STATE_HOME/zsh/history"
[[ -d ${HISTFILE:h} ]] || mkdir -p "${HISTFILE:h}"
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space \
       hist_reduce_blanks hist_verify

# --- keys: emacs mode (chosen explicitly; EDITOR=nvim would otherwise pick vi)
bindkey -e
bindkey '^[[1;5C' forward-word         # Ctrl-Right
bindkey '^[[1;5D' backward-word        # Ctrl-Left
bindkey '^[[H' beginning-of-line       # Home
bindkey '^[[F' end-of-line             # End
bindkey '^[[3~' delete-char            # Delete
[[ -n ${terminfo[khome]} ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n ${terminfo[kend]}  ]] && bindkey "${terminfo[kend]}"  end-of-line
[[ -n ${terminfo[kdch1]} ]] && bindkey "${terminfo[kdch1]}" delete-char

# Ctrl-X Ctrl-E: edit the current command in nvim
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# --- completion --------------------------------------------------------------
fpath=("$ZDOTDIR/completions" $fpath)
autoload -Uz compinit
_zcompdump="$XDG_CACHE_HOME/zsh/zcompdump"
[[ -d ${_zcompdump:h} ]] || mkdir -p "${_zcompdump:h}"
# Full check at most once a day; otherwise trust the cached dump.
_stale=( $_zcompdump(N.mh+24) )
if [[ ! -f $_zcompdump ]] || (( ${#_stale} )); then
  compinit -d "$_zcompdump"
else
  compinit -C -d "$_zcompdump"
fi
unset _zcompdump _stale

zstyle ':completion:*' menu select
zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' completer _expand _complete _correct _approximate
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'

# --- the rest ----------------------------------------------------------------
for _f in theme aliases prompt plugins; do
  [[ -r $ZDOTDIR/$_f.zsh ]] && source "$ZDOTDIR/$_f.zsh"
done
unset _f

# Machine-local additions (not in the repo).
[[ -r $ZDOTDIR/local.zsh ]] && source "$ZDOTDIR/local.zsh"

# --- terminal windows open in tmux -------------------------------------------
# Ghostty's, and Windows Terminal's on Windows (WT_SESSION, which WSL passes
# in). Each window is its own tmux session (tabs and splits are tmux's:
# prefix c, \ and -), in the folder the window opened in, and gone when the
# window closes. dev's project sessions are separate and stay. Not inside
# tmux, not over SSH, not for `ghostty -e <cmd>` (no shell), and off with
# RIG_NO_TMUX=1. If tmux can't start, you get this shell instead. Last in this
# file, so the tmux server (and its popups) gets the full environment: theme,
# fzf, DOCKER_HOST.
if [[ ( $TERM_PROGRAM == ghostty || -n $WT_SESSION ) && -z $TMUX && -z $SSH_CONNECTION && -z $RIG_NO_TMUX ]] && (( $+commands[tmux] )); then
  tmux new-session \; set-option destroy-unattached on \; set-option @rig_window 1 && exit
fi
