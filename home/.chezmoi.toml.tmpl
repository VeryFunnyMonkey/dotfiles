{{- /*
  chezmoi's config for this machine. It asks nothing: `rig setup` (the
  installer) writes the choices below, and detection fills in the facts.
  Re-rendered by `chezmoi init`, keeping whatever is stored.
*/ -}}
{{- $d := includeTemplate "detect" . | fromJson -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}
mode = "symlink"

[data]
    # chosen with `rig setup` (or rig add/remove, rig profile use)
    profile = {{ dig "profile" "" . | quote }}
    selected = {{ dig "selected" list . | toToml }}
    extra_packages = {{ dig "extra_packages" list . | toToml }}
    agent_default = {{ dig "agent_default" "" . | quote }}
    # detected
    wsl = {{ $d.wsl }}
    display = {{ $d.display | quote }}
    desktop = {{ $d.desktop | quote }}
